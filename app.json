{
  "expo": {
    "name": "Sumapos",
    "slug": "sumapos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/ios-dark.png",
    "scheme": "sumapos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/app-icon/adaptive-icon-background.png",
        "monochromeImage": "./assets/app-icon/adaptive-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.codesbyree.sumapos"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c49d642-977f-400a-9aff-2495b5e4d55d"
      }
    },
    "owner": "bahree36"
  }
}
